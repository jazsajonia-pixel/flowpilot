{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/dispatch.ts": {
      "includeFiles": "server-build/dispatcher.mjs",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/internal/schedule-tick",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/dispatch?__fp_path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
