# FlowPilot AI — Environment Variables Example
# Copy this file to .env for local development. Never commit real secrets.

# Netlify Database / PostgreSQL connection string
# Automatically provided by Netlify environment in production/preview.
# For local development or drizzle-kit CLI:
NETLIFY_DB_URL="postgresql://user:password@localhost:5432/flowpilot?schema=public"

# Built-in Gemini provider (server-side only; never use a VITE_ prefix)
# User-managed Gemini/OpenAI keys are entered in the authenticated AI Providers UI instead.
GEMINI_API_KEY=""
# Optional server-managed model override for the built-in Gemini provider.
# AI workflow nodes can also choose a curated per-node model.
GEMINI_MODEL_ID="gemini-3.8-flash"

# Credential vault master key (server-side only; never use a VITE_ prefix)
# Generate exactly 32 random bytes encoded as Base64, for example: openssl rand -base64 32
# Use a separate value per environment and keep it stable for that environment's database.
# If lost, stored keys in that database cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEY=""

# Send Email action (server-side only). Leave blank to disable email; Send Email nodes then fail safely.
# RESEND_API_KEY comes from https://resend.com; EMAIL_FROM must use a domain verified in Resend,
# e.g. "FlowPilot <notifications@example.com>". Emails go only to the workflow owner's account email.
RESEND_API_KEY=""
EMAIL_FROM=""

# Vercel Cron bearer secret for /api/internal/schedule-tick (Production only, at least 16 random characters).
CRON_SECRET=""

# Application Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Authentication
# Phase 2C uses random opaque session tokens stored as one-way hashes; no signing secret is required.
