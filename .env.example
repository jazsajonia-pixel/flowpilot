# FlowPilot AI — Environment Variables Example
# Copy this file to .env and fill in the values for local development.
# DO NOT commit real secrets or .env to source control.

# Netlify Database / PostgreSQL connection string
# Automatically provided by Netlify environment in production/preview.
# For local development or drizzle-kit CLI:
NETLIFY_DB_URL="postgresql://user:password@localhost:5432/flowpilot?schema=public"

# AI Providers
# Default built-in FlowPilot AI provider key (Google Gemini)
GEMINI_API_KEY=""

# Optional user-provided keys for development/testing (Handled server-side)
OPENAI_API_KEY=""

# Application Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Authentication (To be configured in Phase 2C)
JWT_SECRET=""
