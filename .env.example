# FlowPilot AI — Environment Variables Example
# Copy this file to .env and fill in the values for local development.
# DO NOT commit real secrets or .env to source control.

# Database
# PostgreSQL connection string (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/flowpilot?schema=public"

# AI Providers
# Default built-in FlowPilot AI provider key (Google Gemini)
GEMINI_API_KEY=""

# Optional user-provided keys for development/testing (Handled server-side)
OPENAI_API_KEY=""

# Application Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Authentication (To be configured in Phase 3)
JWT_SECRET=""
